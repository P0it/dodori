# 클라이언트 노출 가능 (PRD §10)
# 개발·실기기 모두 원격에 바로 붙는다 — 로컬 Docker 스택(127.0.0.1:54321)은 쓰지 않는다
EXPO_PUBLIC_SUPABASE_URL=https://iyqttrufrjeytntinsrb.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
KAKAO_NATIVE_APP_KEY=
# 웹 배포 주소 — 초대 링크(https://<여기>/invite/CODE)를 앱에서 만들 때 쓴다.
# 웹에서는 열려 있는 주소를 자동으로 쓰므로 필요 없고, 네이티브 빌드에만 필요하다.
# 미설정이면 링크 대신 초대 코드만 공유된다.
EXPO_PUBLIC_WEB_URL=
# 네이버 지도(NCP) 클라이언트 ID — Mobile Dynamic Map 이용신청 후 발급. 앱에 박히므로 시크릿 아님.
# 콘솔에 Android 패키지명·iOS 번들 ID(com.hyunwoo.dodori) 등록 필요. 변경 후 dev client 재빌드.
# 네이티브(SDK)는 NAVER_MAP_CLIENT_ID, 웹(JS API)은 EXPO_PUBLIC_ 변수를 쓴다 — 같은 값 두 곳에.
# 웹은 콘솔 Web 서비스 URL을 포트·경로 없이 호스트만 등록해야 한다 (예: http://localhost).
NAVER_MAP_CLIENT_ID=
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=

# Sentry(크래시 리포팅). DSN은 공개값 — 미설정이면 _layout.tsx가 init을 건너뛴다.
# 소스맵 업로드용 auth token은 커밋되면 안 되므로 app.json이 아니라 여기/EAS 시크릿에 둔다.
# org·project 슬러그는 app.json의 @sentry/react-native 플러그인 옵션에 있다.
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Edge Function 전용 — supabase secrets로 관리, 여기에 넣지 않음:
#   NAVER_CLIENT_ID / NAVER_CLIENT_SECRET / SERVICE_ROLE_KEY

# 포트폴리오 둘러보기(/demo)용 데모 계정 — 미설정 시 /demo가 안내 문구만 보여준다
EXPO_PUBLIC_DEMO_EMAIL=
EXPO_PUBLIC_DEMO_PASSWORD=

# 웹 푸시(VAPID) — `npx web-push generate-vapid-keys`로 쌍을 1회 생성한다.
# 공개키는 앱 번들에 박히는 값이라 시크릿이 아니고, 개인키와 워커 시크릿은 Vercel에만 둔다.
# (워커 = api/notifications/deliver.ts. SUPABASE_URL은 위 EXPO_PUBLIC_ 값을 재사용한다)
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
# 아래 셋은 로컬에 둘 필요가 없다 — Vercel 환경변수로만 설정한다:
#   VAPID_PRIVATE_KEY / NOTIFY_WORKER_SECRET / SUPABASE_SERVICE_ROLE_KEY
# 그리고 SQL Editor에서 Vault에 notify_worker_url · notify_worker_secret 등록 (CLAUDE.md 참고)
