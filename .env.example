# 클라이언트 노출 가능 (PRD §10)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
KAKAO_NATIVE_APP_KEY=
# 네이버 지도(NCP) 클라이언트 ID — Mobile Dynamic Map 이용신청 후 발급. 앱에 박히므로 시크릿 아님.
# 콘솔에 Android 패키지명·iOS 번들 ID(com.hyunwoo.dodori) 등록 필요. 변경 후 dev client 재빌드.
# 네이티브(SDK)는 NAVER_MAP_CLIENT_ID, 웹(JS API)은 EXPO_PUBLIC_ 변수를 쓴다 — 같은 값 두 곳에.
# 웹은 콘솔 Web 서비스 URL을 포트·경로 없이 호스트만 등록해야 한다 (예: http://localhost).
NAVER_MAP_CLIENT_ID=
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=

# Edge Function 전용 — supabase secrets로 관리, 여기에 넣지 않음:
#   NAVER_CLIENT_ID / NAVER_CLIENT_SECRET / SERVICE_ROLE_KEY
